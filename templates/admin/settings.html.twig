{#
	Administration > Settings: every group of settings, CattoPHP's and the project's, each a section that opens to its form
	and is saved on its own. Each setting says where its value comes from; one saved here has a Reset beside it, which puts
	.env's value (or its default) back. Each Reset is a form of its own after the group's (the button beside its field names
	it with form=) and asks to be confirmed, so Enter in a field only ever saves the group. A secret is never shown: a saved
	one shows as asterisks, left as they are to keep it. Someone who may only see the settings sees them without the forms'
	buttons, and is told why. Saved settings that could not be read are said to be so first (read_problem). The project's
	facts (facts: each with its key, heading, explanation, summary and items of label and value) follow the groups, each a
	section of its own (#facts-<key>), shown and never changed.
#}
{% extends '@CattoPHP/page/stock.html.twig' %}
{% block stock_main %}
{% if read_problem %}
<section class="cl-page-section">
{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Saved settings could not be read'})} %}{% block body %}<p>{{ read_problem }}</p>{% endblock %}{% endembed %}
</section>
{% endif %}
{% if why_not %}
<section class="cl-page-section">
{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info'})} %}{% block body %}<p>{{ why_not }}</p>{% endblock %}{% endembed %}
</section>
{% endif %}
<section class="cl-page-section">
{% for group in groups %}
{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: 'settings-' ~ group.key, heading: group.label, summary: group.summary, open: open == group.key or group.refused})} %}{% block body %}
<p>{{ group.description }}</p>
{% include '@CattoPHP/admin/settings-group.html.twig' with {group: group, may_change: may_change, save_action: path('cattophp_admin_settings_save', {group: group.key}), reset_group_action: path('cattophp_admin_settings_reset_group', {group: group.key}), reset_route: 'cattophp_admin_settings_reset', reset_params: {group: group.key}} only %}
{% endblock %}{% endembed %}
{% endfor %}
{% for fact_group in facts %}
{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: 'facts-' ~ fact_group.key, heading: fact_group.heading, summary: fact_group.summary, open: open == fact_group.key})} %}{% block body %}
<p>{{ fact_group.explanation }}</p>
{{ ui('data.key-value-list', {items: fact_group.items}) }}
{% endblock %}{% endembed %}
{% endfor %}
</section>
{% endblock %}
