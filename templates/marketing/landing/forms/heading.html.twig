{#
	The heading and words most section kinds' forms open with (a project's own kinds may include it too). Variables:
	values, form (its limits), errors, section (its default heading), and optionally text_label and text_help.
#}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Heading', for: 'landing-heading', help: 'At most ' ~ form.limits.heading|default(120) ~ ' characters.' ~ (section.default_heading ? ' Left empty, the heading is "' ~ section.default_heading ~ '".' : ''), error: errors.heading|default('')})} %}{% block control %}<input class="cl-input" type="text" id="landing-heading" name="heading" value="{{ values.heading|default('') }}" maxlength="{{ form.limits.heading|default(120) }}" placeholder="{{ section.default_heading }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: text_label|default('Introduction (optional)'), for: 'landing-text', help: text_help|default('Plain text, at most ' ~ form.limits.text|default(1000)|number_format ~ ' characters; an empty line starts a new paragraph.'), error: errors.text|default('')})} %}{% block control %}<textarea class="cl-input" id="landing-text" name="text" rows="4" maxlength="{{ form.limits.text|default(1000) }}" {{ ui_field_attrs(props) }}>{{ values.text|default('') }}</textarea>{% endblock %}{% endembed %}
