{#
	The hero's fields in a landing page's editor: the small line above the heading, the headline (the offer's or
	campaign's name when it is left empty), the supporting text (its placeholder what the hero shows when it is left
	empty, the offer's own words for the hero), the picture (a source as feature cards, its pictures, an
	upload), the second button (to a part of the page) and its words, and, on a campaign's page, a headline and words for
	while the campaign is not running. The badges and rating come from the page's offer.
#}
{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 1})} %}{% block body %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Small line above the heading (optional)', for: 'landing-kicker', help: 'Such as Spring special. At most ' ~ form.limits.kicker ~ ' characters.', error: errors.kicker|default('')})} %}{% block control %}<input class="cl-input" type="text" id="landing-kicker" name="kicker" value="{{ values.kicker|default('') }}" maxlength="{{ form.limits.kicker }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Headline', for: 'landing-headline', help: 'At most ' ~ form.limits.headline ~ ' characters. Left empty, the headline is "' ~ form.placeholder ~ '".', error: errors.headline|default('')})} %}{% block control %}<input class="cl-input" type="text" id="landing-headline" name="headline" value="{{ values.headline|default('') }}" maxlength="{{ form.limits.headline }}" placeholder="{{ form.placeholder }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Supporting text', for: 'landing-text', help: 'A sentence or two under the headline, at most ' ~ form.limits.text ~ ' characters. Left empty, the ' ~ section.offer_word ~ '\'s own line is used.', error: errors.text|default('')})} %}{% block control %}<textarea class="cl-input" id="landing-text" name="text" rows="4" maxlength="{{ form.limits.text }}"{% if section.text_placeholder|default('') != '' %} placeholder="{{ section.text_placeholder }}"{% endif %} {{ ui_field_attrs(props) }}>{{ values.text|default('') }}</textarea>{% endblock %}{% endembed %}
{% include '@CattoPHP/marketing/landing/forms/picture-field.html.twig' with {picture: pictures.picture, legend: 'Picture', error: errors.picture|default(''), may_upload: may_upload} only %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Second button', for: 'landing-secondary', help: 'Beside the main button: a link to a part of this page, or to an address the ' ~ section.offer_word ~ ' gives, such as a free preview. It is left out when that part is not on the page.', error: errors.secondary|default('')})} %}{% block control %}<select class="cl-select" id="landing-secondary" name="secondary" {{ ui_field_attrs(props) }}><option value="none">No second button</option>{% for value, label in section.targets %}<option value="{{ value }}"{{ values.secondary|default('none') == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Second button\'s words (optional)', for: 'landing-secondary-label', help: 'At most ' ~ form.limits.secondary_label ~ ' characters. Left empty, it says where it leads.', error: errors.secondary_label|default('')})} %}{% block control %}<input class="cl-input" type="text" id="landing-secondary-label" name="secondary_label" value="{{ values.secondary_label|default('') }}" maxlength="{{ form.limits.secondary_label }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% if form.not_running %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Headline while the campaign is not running (optional)', for: 'landing-not-running-headline', help: 'Before it starts, while it is paused and after it ends. Left empty, the headline above is kept.', error: errors.not_running_headline|default('')})} %}{% block control %}<input class="cl-input" type="text" id="landing-not-running-headline" name="not_running_headline" value="{{ values.not_running_headline|default('') }}" maxlength="{{ form.limits.not_running_headline }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Words while the campaign is not running (optional)', for: 'landing-not-running-text', help: 'Shown with that headline, at most ' ~ form.limits.not_running_text ~ ' characters.', error: errors.not_running_text|default('')})} %}{% block control %}<textarea class="cl-input" id="landing-not-running-text" name="not_running_text" rows="3" maxlength="{{ form.limits.not_running_text }}" {{ ui_field_attrs(props) }}>{{ values.not_running_text|default('') }}</textarea>{% endblock %}{% endembed %}
{% endif %}
{% endblock %}{% endembed %}
