{#
	A "who it is for" section's fields: a heading and words, and up to twelve points, each a line and, if wanted, a bold
	title above it (drawn as cards when any has one).
#}
{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 1})} %}{% block body %}
{% include '@CattoPHP/marketing/landing/forms/heading.html.twig' %}
{% include '@CattoPHP/marketing/landing/forms/rows.html.twig' with {rows_legend: 'Who it is for', rows_help: 'One point a row, such as Gardeners with a small balcony. A title is optional; with one, the points are drawn as cards.', rows_most: form.limits.items, rows_spare: 2,
	first: {key: 'title', label: 'Title (optional)', max: form.limits.title, prose: false}, second: {key: 'text', label: 'Point', max: form.limits.item, prose: false}} %}
{% endblock %}{% endembed %}
