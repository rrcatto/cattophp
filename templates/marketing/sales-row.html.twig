{#
	One sale as a row of the Sales list (row: SaleWords::row()): when it was paid or placed, its order (opening its page),
	the customer (opening their journey, for a reader who may see who customers are), what was bought, its campaign and
	what it came through, the country, gross, refunds and net (what it is to pay while it is not paid), and its state,
	with "Sold on <site>" for a connected site's sale.
#}
<tr><td data-label="Paid or placed">{{ row.when }}{% if not row.paid %} <small class="cl-marketing-line">{{ row.when_words }}</small>{% endif %}</td><td class="cell-text" data-label="Order"><a href="{{ row.href }}">{{ row.reference }}</a></td><td class="cell-text" data-label="Customer">{% if row.customer_href %}<a href="{{ row.customer_href }}">{{ row.customer }}</a>{% else %}{{ row.customer }}{% endif %}{% if row.customer_note %} <small class="cl-marketing-line">{{ row.customer_note }}</small>{% endif %}</td><td class="cell-text" data-label="Bought">{{ row.bought }}</td><td class="cell-text" data-label="Campaign">{% if row.campaign_href %}<a href="{{ row.campaign_href }}">{{ row.campaign }}</a>{% else %}{{ row.campaign }}{% endif %}</td><td class="cell-text" data-label="Came through">{{ row.through }}</td><td class="cell-text" data-label="Country">{{ row.country }}</td>{% if row.paid %}<td class="text-end" data-label="Gross">{{ row.gross }}</td><td class="text-end" data-label="Refunds">{{ row.refunds }}{% if row.charged_back %} <small class="cl-marketing-line">{{ row.charged_back }}</small>{% endif %}</td><td class="text-end" data-label="Net">{{ row.net }}</td>{% else %}<td class="text-end" data-label="Gross">Not paid <small class="cl-marketing-line">{{ row.unpaid }}</small></td><td class="text-end" data-label="Refunds">None</td><td class="text-end" data-label="Net">None</td>{% endif %}<td data-label="State">{{ ui('feedback.badge', {label: row.state, tone: row.tone, size: 'small'}) }}{% if row.sold_on %} {{ ui('feedback.badge', {label: row.sold_on, tone: 'info', size: 'small'}) }}{% endif %}{% if row.other_currency %} {{ ui('feedback.badge', {label: 'Not in the totals', size: 'small'}) }}{% endif %}</td></tr>
