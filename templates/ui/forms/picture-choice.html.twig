{#
	A native radio group whose options are pictures (a design's look) or feature cards: an SVG icon, a bold label and a
	description (such as an account's type). size 'small' draws smaller cards, icon beside the title, for a choice that
	sits under a larger one (a form's topics). columns 4 puts at most four cards in a row, further rows beneath,
	left-aligned. An option may be one of the project's own drawings (a DrawingCheck it registered allows it), chosen by
	what it looks like. form ties the radios to a form elsewhere on the page (a window's choice sent with the page's own
	form). multiple makes every card a checkbox of its own, named by its value and sent as 1 when ticked, the ticked
	values listed in selected. list makes the cards share one field, list[], each sent
	as its value. tick_value is what a named card sends instead of 1. required makes every control required, an item's
	disabled greys that one out, legend_hidden keeps the legend for screen readers only, and columns 1 stacks the cards. A
	lone card takes the whole row. The blocks item_label and item_note hold words that need markup, such as a link, when
	this is embedded. Every option is a labelled native radio or checkbox, so the choice works without JavaScript.
#}
{% set cards = props.items|filter(item => item.icon is defined)|length == props.items|length %}
<fieldset class="cl-ui-picture-choice{{ cards ? ' cl-ui-picture-choice--cards' : '' }}{{ props.multiple ? ' cl-ui-picture-choice--multiple' : '' }}{{ props.size == 'small' ? ' cl-ui-picture-choice--small' : '' }}{{ props.columns == 4 ? ' cl-ui-picture-choice--four' : '' }}{{ props.columns == 1 ? ' cl-ui-picture-choice--one' : '' }}{{ props.items|length == 1 ? ' cl-ui-picture-choice--single' : '' }}"{% if props.id %} id="{{ props.id }}"{% endif %}><legend class="cl-ui-picture-choice-legend{{ props.legend_hidden ? ' visually-hidden' : '' }}">{{ props.legend }}</legend>{% if props.help %}<div class="cl-ui-field-help">{{ props.help }}</div>{% endif %}<div class="cl-ui-picture-choice-grid">{% for item in props.items %}<label class="cl-ui-picture-choice-item{{ item.icon is defined ? ' cl-ui-picture-choice-item--icon' : '' }}{{ item.drawing is defined ? ' cl-ui-picture-choice-item--drawing' : '' }}">{% if props.multiple %}<input type="checkbox" name="{{ props.list ? props.list ~ '[]' : item.value }}" value="{{ props.list ? item.value : props.tick_value }}"{% if props.form %} form="{{ props.form }}"{% endif %}{% if item.value in props.selected %} checked{% endif %}{% if props.required %} required{% endif %}{% if item.disabled|default(false) %} disabled{% endif %}>{% else %}<input type="radio" name="{{ props.name }}" value="{{ item.value }}"{% if props.form %} form="{{ props.form }}"{% endif %}{% if (item.value ~ '') == (props.selected ~ '') %} checked{% endif %}{% if props.required %} required{% endif %}{% if item.disabled|default(false) %} disabled{% endif %}>{% endif %}{% if item.icon is defined %}<span class="cl-ui-picture-choice-icon" aria-hidden="true">{{ item.icon|authored }}</span>{% elseif item.drawing is defined %}<span class="cl-ui-picture-choice-drawing">{{ item.drawing|authored }}</span>{% else %}<img src="{{ item.image }}" alt="" loading="lazy">{% endif %}<span class="cl-ui-picture-choice-text"><span class="cl-ui-picture-choice-label">{% block item_label %}{{ item.label }}{% endblock %}</span>{% block item_note %}{% if item.note|default('') %}<span class="cl-ui-picture-choice-note">{{ item.note }}</span>{% endif %}{% endblock %}</span></label>{% endfor %}</div></fieldset>
