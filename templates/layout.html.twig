{#- The plainest page frame, used until a project names its own (`cattophp.layout`). Its pages fill the block body. -#}
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title|default('') }}{% if installation.name %} · {{ installation.name }}{% endif %}</title>
</head>
<body>
{% if site_mode.isDemo %}<div class="cl-site-demo" role="note"><strong>{{ site_mode.heading }}</strong> {{ site_mode.notice }}</div>{% endif %}
{% block body %}{% endblock %}
</body>
</html>
