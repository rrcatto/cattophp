{# The page an emailed link opens. Opening it uses nothing, so a mail scanner that follows it does no harm: the button does. #}
{% extends '@CattoPHP/page/stock.html.twig' %}
{% block stock_main %}
<section class="cl-page-section cl-sign-in">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {labelledby: 'link-heading'})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Your link', heading_id: 'link-heading', summary: 'Press the button to sign in. The link then cannot be used again.'}) }}
<form method="post" action="{{ path('cattophp_sign_in_link_use', {token: link}) }}">
<input type="hidden" name="_token" value="{{ form_token() }}">
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Sign in', type: 'submit', icon: 'action-open', variant: 'primary'}) }}{% endblock %}{% endembed %}
</form>
{% endblock %}{% endembed %}
</section>
{% endblock %}
