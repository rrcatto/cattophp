{% extends cattophp_layout %}
{% block body %}
<main class="cl-sign-in">
<h1>{{ title }}</h1>
{% if set_up %}
<p>Type the code your authenticator app shows now{% if recovery_codes %}, or one of your recovery codes{% endif %}.</p>
{% else %}
<p>This sign-in asks for a code from your phone as well as your email. In the authenticator app on your phone, add an account and scan this QR code.</p>
<div class="cl-two-step-qr">{{ qr_code|raw }}</div>
<details><summary>Cannot scan it? Type a key instead</summary><p class="cl-two-step-key">{{ secret }}</p></details>
<p>Then type the 6 digits the app shows, to prove it holds the key. Until then nothing is kept.</p>
{% endif %}
{% if note %}<p class="cl-sign-in-note" role="status"><strong>{{ note }}</strong></p>{% endif %}
<form method="post" action="{{ path('cattophp_sign_in_code_check') }}">
<input type="hidden" name="_token" value="{{ form_token() }}">
<label>{% if set_up and recovery_codes %}The code{% else %}The 6 digits it shows now{% endif %} <input type="text" name="code" required autocomplete="one-time-code" maxlength="12" spellcheck="false"></label>
<button type="submit">Sign in</button>
</form>
</main>
{% endblock %}
